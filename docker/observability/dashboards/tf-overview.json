    {
      "datasource": {
        "type": "tempo",
        "uid": "tf-tempo"
      },
      "description": "Server spans are named after the route pattern, never the concrete path, so no repo name or other tenant data reaches this list. Click a row to open that trace's waterfall. The DB spans underneath usually explain the time. Empty is the healthy state.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
