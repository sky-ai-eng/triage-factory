{
  "description": "Is TF healthy, and what is slow. Provisioned from docker/observability/dashboards/ \u2014 edits made here cannot be saved back.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "description": "Fixed TraceQL against Tempo. These are searches, not aggregates: each row is one trace, and opening it is the whole point of the row.",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Traces \u2014 what just happened",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tf-tempo"
      },
      "description": "One row per per-org GitHub poll. Click a row to open that trace's waterfall. Duration is the whole org's refresh + diff + emit; the waterfall says which repo batch spent it. An empty list means no org polled GitHub in the window \u2014 which for an org that tracks no repos is the correct answer, not a fault.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tf-tempo"
          },
          "filters": [],
          "limit": 20,
          "query": "{ name = \"poll.github.org\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "GitHub poll cycles",
      "type": "table"
    },
