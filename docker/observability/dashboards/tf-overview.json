    {
      "datasource": {
        "type": "tempo",
        "uid": "tf-tempo"
      },
      "description": "Every span that ended with an error status, any subsystem. Click a row to open that trace's waterfall. Anticipated skips (provider backoff, dedup, quiet-skip) are recorded as an `outcome` attribute rather than an error status, so this list stays things that are actually wrong.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
