        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tf-tempo"
          },
          "filters": [],
          "limit": 20,
          "query": "{ name =~ \"GET /api/.*\" && duration > 500ms }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "API requests slower than 500 ms",
      "type": "table"
