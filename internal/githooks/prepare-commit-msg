#!/bin/sh
# Triage Factory prepare-commit-msg hook.
#
# Two jobs, both best-effort and non-blocking by contract: the hook always exits
# 0, so it never aborts a commit. git invokes it with the path to the
# commit-message file as $1 and the message's source as $2 ("merge" for any
# merge commit, including `git pull`'s).
#
#  1. Merge titles. Git names a merged remote by the URL it fetched from, and
#     a run's managed remote resolves to the per-run git proxy through the
#     insteadOf rewrite TF puts in its git config. That rewrite's config block
#     also carries triagefactory.proxyBase and triagefactory.upstreamBase, and
#     the hook puts the upstream base back in the title. Git also ends the
#     title with " into <branch>" for the local branch HEAD is on, and a PR
#     checkout's local branch is a name nobody outside the run knows: TF
#     pushes it to the pull request's head branch through an explicit push
#     refspec. When a push refspec sends the branch to a branch of another
#     name, the hook names that branch instead. A branch pushed under its own
#     name has no such mapping and keeps its title, and a title that only
#     mentions the branch somewhere else (a `git merge -m` message, say)
#     keeps every word. A commit that is not a merge is left alone.
#
#  2. Co-authored-by trailer. Credits the delegating human on MANUAL
#     delegated-agent runs, so a commit authored by the org's GitHub identity
#     also co-attributes the person who kicked off the run. The org identity
#     remains the sole author/committer (set via injected user.name/user.email
#     git config); this trailer is additive-only. The delegate sets
#     TRIAGE_FACTORY_GIT_COAUTHOR_TRAILER to the full trailer line ONLY for a
#     manual run whose org login differs from the delegating user's. Unset
#     (autonomous/event runs, or the N=1 same-login case) => no trailer. The
#     hook fires for every commit in every repo via the process-scoped
#     core.hooksPath; the env gate is what scopes it to the right runs.
#     Idempotent: a re-delegation onto an existing branch, a `git commit
#     --amend`, or a commit-message edit re-runs this hook over a message that
#     may already carry the trailer — the grep guard means it's appended at
#     most once.

f="$1"

if [ "$2" = merge ]; then
	title=$(sed -n 1p "$f" 2>/dev/null)
	new=$title
	base=$(git config --get triagefactory.proxyBase)
	upstream=$(git config --get triagefactory.upstreamBase)
	if [ -n "$base" ] && [ -n "$upstream" ]; then
		rest=$new
		new=
		while :; do
			case $rest in
			*"$base"*)
				new=$new${rest%%"$base"*}$upstream
				rest=${rest#*"$base"}
				;;
			*) break ;;
			esac
		done
		new=$new$rest
	fi
	branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
	if [ -n "$branch" ]; then
		dest=$(git for-each-ref --format='%(push:remoteref)' "refs/heads/$branch" 2>/dev/null)
		dest=${dest#refs/heads/}
		case $new in
		*" into $branch")
			if [ -n "$dest" ] && [ "$dest" != "$branch" ]; then
				new="${new%" into $branch"} into $dest"
			fi
			;;
		esac
	fi
	if [ "$new" != "$title" ]; then
		{ printf '%s\n' "$new"; sed 1d "$f"; } >"$f.tf" && mv "$f.tf" "$f" || rm -f "$f.tf"
	fi
fi

[ -n "$TRIAGE_FACTORY_GIT_COAUTHOR_TRAILER" ] || exit 0
grep -qiF "$TRIAGE_FACTORY_GIT_COAUTHOR_TRAILER" "$f" 2>/dev/null && exit 0
printf '\n%s\n' "$TRIAGE_FACTORY_GIT_COAUTHOR_TRAILER" >> "$f"
exit 0
