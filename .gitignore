# Binary
/pollbench
triagefactory

# Frontend
# Unanchored, so a stray install or tool cache anywhere in the tree (a
# root-level node_modules from running npx outside frontend/, say) is ignored
# rather than sitting there waiting to be swept into a commit.
node_modules/
frontend/dist/
.pnpm-store/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Custom
_scratch/
_tfac/
.claude/*
.codex/*
!.codex/hooks.json
!.claude/settings.json
docs/triagefactory-spec.md
docs/oauth-smoke.html
.env
.env.multi-dev
.multi-dev-state/
triage-factory
bench-results/

# Deployment-local compose additions and mounted secret files (see
# docs/self-hosting/secrets.md). The install guide has an operator create
# both in the checkout, so they are ignored here rather than left to a
# careful `git add`.
compose.override.yml
docker-compose.override.yml
secrets/
